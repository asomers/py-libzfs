PYTHON ?= python3
PREFIX ?= /usr/local

PXIS = \
	converter.pxi \
	nvpair.pxi \
	pxd/config.pxi \
	pxd/sendflags.pxi

PXDS = \
	pxd/libzfs.pxd \
	pxd/nvpair.pxd \
	pxd/types.pxd \
	pxd/zfs.pxd

build: libzfs.c

libzfs.c: libzfs.pyx ${PXIS} ${PXDS} pyproject.toml
	rm -f libzfs.c
	${PYTHON} -m build --no-isolation --wheel
	@if [ -f libzfs.c ]; then :; elif [ -n "$$(find build -name 'libzfs.c' -print -quit 2>/dev/null)" ]; then \
		cp "$$(find build -name 'libzfs.c' -print -quit)" libzfs.c; \
	fi

clean:
	rm -rf build dist libzfs.egg-info libzfs.c

distclean: clean
	rm -f Makefile config.status config.log config.h pyproject.toml
	rm -f pxd/config.pxi pxd/sendflags.pxi pxd/spa_features.pxi
	rm -f pxd/userquota_props.pxi pxd/zpool_status.pxi

install:
	${PYTHON} -m pip install . --no-deps --prefix ${PREFIX}
