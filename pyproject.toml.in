[build-system]
requires = ["setuptools>=74.1", "Cython"]
build-backend = "setuptools.build_meta"

[project]
name = "libzfs"
version = "2.0.2"
description = "Python bindings for libzfs"
readme = "README.md"
maintainers = [ {name = "Alan Somers", email = "asomers@FreeBSD.org"}, {name = "Johan Söllvander", email = "js@FreeBSD.org"}  ]

[tool.setuptools]
py-modules = []
ext-modules = [
  {name = "libzfs", sources = ["libzfs.pyx"], libraries = [@LIBRARIES_TOML@], extra-compile-args = [@EXTRA_COMPILE_ARGS_TOML@], extra-link-args = [@EXTRA_LINK_ARGS_TOML@], include-dirs = ["./pxd"]},
]
